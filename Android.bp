// GhostWire — independent, self-contained pentest app.
// Included in a ROM via its own ghostwire.mk; not tied to any device tree.

// Vendored osmdroid (OSM map view) — AOSP ships no prebuilt; the AAR is kept
// under libs/. osmdroid-android 6.1.x has no transitive compile deps.
android_library_import {
    name: "ghostwire-osmdroid-android",
    aars: ["libs/osmdroid-android-6.1.20.aar"],
    sdk_version: "current",
}

android_app {
    name: "GhostWire",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    asset_dirs: ["assets"],
    manifest: "AndroidManifest.xml",

    // Builds against the system SDK so the app stays portable; platform
    // certificate + privileged install are what grant it the telephony/USB
    // permissions its privapp allowlist requests.
    sdk_version: "system_current",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,

    static_libs: [
        "androidx.core_core",
        "androidx.appcompat_appcompat",
        "androidx.drawerlayout_drawerlayout",
        "androidx.fragment_fragment",
        "androidx.viewpager2_viewpager2",
        "androidx.recyclerview_recyclerview",
        "com.google.android.material_material",
        "ghostwire-osmdroid-android",
    ],
}

// Native DIAG helper: NV item read/write over /dev/diag (root). Shipped to
// /system_ext/bin and exec'd by the DIAG tab; see native/ghostwire_diag.c.
cc_binary {
    name: "ghostwire_diag",
    srcs: ["native/ghostwire_diag.c"],
    cflags: ["-Wall", "-Werror"],
    system_ext_specific: true,
}
