<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Ghost Wire design system (Foundations + Components spec). A fixed Material 3
         dark theme pinned to the Foundations palette (mint #3CF2B0 on ground #0B0F14),
         Space Grotesk for display/body and JetBrains Mono for labels, radii 8/12/20.
         Not Monet: the app carries its own identity. gw_* tokens resolve to the
         forced-night values in res/values-night. -->
    <style name="Theme.GhostWire" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/gw_accent</item>
        <item name="colorOnPrimary">@color/gw_on_accent</item>
        <item name="colorPrimaryContainer">@color/gw_raised</item>
        <item name="colorOnPrimaryContainer">@color/gw_accent</item>
        <item name="colorSecondary">@color/gw_accent</item>
        <item name="colorOnSecondary">@color/gw_on_accent</item>
        <item name="android:colorBackground">@color/gw_ground</item>
        <item name="colorSurface">@color/gw_surface</item>
        <item name="colorOnSurface">@color/gw_text</item>
        <item name="colorSurfaceVariant">@color/gw_raised</item>
        <item name="colorOnSurfaceVariant">@color/gw_muted</item>
        <item name="colorOutline">@color/gw_line</item>
        <item name="colorOutlineVariant">@color/gw_line</item>
        <item name="colorError">@color/gw_critical</item>
        <item name="colorOnError">@color/gw_on_accent</item>
        <item name="colorSurfaceContainerLowest">@color/gw_ground</item>
        <item name="colorSurfaceContainerLow">@color/gw_ground</item>
        <item name="colorSurfaceContainer">@color/gw_surface</item>
        <item name="colorSurfaceContainerHigh">@color/gw_raised</item>
        <item name="colorSurfaceContainerHighest">@color/gw_raised</item>
        <!-- inputs, switches, progress, cursors adopt mint + the line colour -->
        <item name="colorControlActivated">@color/gw_accent</item>
        <item name="colorControlNormal">@color/gw_line</item>
        <item name="colorControlHighlight">#2E3B4D</item>
        <item name="android:textColorHint">@color/gw_muted</item>
        <item name="android:statusBarColor">@color/gw_ground</item>
        <item name="android:navigationBarColor">@color/gw_ground</item>
        <!-- type: Space Grotesk is the default family app-wide -->
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <!-- body copy: Space Grotesk ~medium, text colour -->
        <item name="android:textViewStyle">@style/GhostWire.Body</item>
        <!-- component defaults -->
        <item name="materialButtonStyle">@style/GhostWire.Button</item>
        <item name="materialButtonOutlinedStyle">@style/GhostWire.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/GhostWire.Card</item>
        <item name="toolbarStyle">@style/GhostWire.Toolbar</item>
        <item name="floatingActionButtonStyle">@style/GhostWire.Fab</item>
    </style>

    <!-- ============================ Typography ============================ -->

    <!-- Display / section header: Space Grotesk 700, mint. -->
    <style name="GhostWire.Header" parent="">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:fontVariationSettings">'wght' 700</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Mono label: JetBrains Mono 500, caps, tracked .14em, muted. -->
    <style name="GhostWire.MonoLabel" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:fontVariationSettings">'wght' 500</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Monospace output blocks (scan logs etc.) keep JetBrains Mono. -->
    <style name="GhostWire.Mono" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <!-- App-wide default for plain TextViews: Space Grotesk 450, text colour.
         Layout/explicit styles (monospace outputs, headers) still override this. -->
    <style name="GhostWire.Body" parent="Widget.MaterialComponents.TextView">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:fontVariationSettings">'wght' 450</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <!-- ============================ Buttons ============================== -->

    <!-- Primary: mint fill, dark text, radius 12. -->
    <style name="GhostWire.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:fontVariationSettings">'wght' 600</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Secondary: mint outline + mint text. -->
    <style name="GhostWire.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:fontVariationSettings">'wght' 600</item>
        <item name="strokeColor">@color/gw_accent</item>
        <item name="android:textColor">@color/gw_accent</item>
        <item name="rippleColor">#333CF2B0</item>
    </style>

    <!-- Ghost: borderless, plain text. -->
    <style name="GhostWire.Button.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:fontVariationSettings">'wght' 600</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Stop / destructive: critical outline + critical text. -->
    <style name="GhostWire.Button.Stop" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:fontVariationSettings">'wght' 600</item>
        <item name="strokeColor">@color/gw_critical</item>
        <item name="android:textColor">@color/gw_critical</item>
        <item name="rippleColor">#33FF5D6C</item>
    </style>

    <!-- ========================= Glass surfaces ========================= -->

    <!-- Glass card: translucent raised over the ground, hairline stroke, radius 20,
         soft elevation so it floats. -->
    <style name="GhostWire.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/gw_glass</item>
        <item name="strokeColor">@color/gw_glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">6dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Glass floating action button: translucent fill, mint glyph, floats. -->
    <style name="GhostWire.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/gw_glass</item>
        <item name="tint">@color/gw_accent</item>
        <item name="elevation">8dp</item>
        <item name="borderWidth">1dp</item>
        <item name="rippleColor">#333CF2B0</item>
    </style>

    <!-- Toolbar: ghost logo + Space Grotesk 700 title. -->
    <style name="GhostWire.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/GhostWire.ToolbarTitle</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
    </style>

    <style name="GhostWire.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:fontVariationSettings">'wght' 700</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ===================== Severity badge chips ======================= -->
    <!-- Radius 8, JetBrains Mono caps, tinted fill; text colour set per variant. -->
    <style name="GhostWire.Badge" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:fontVariationSettings">'wght' 500</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textSize">11sp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- ===================== Bottom nav + tab pills ===================== -->

    <style name="GhostWire.TabPill" parent="Widget.Material3.TabLayout">
        <item name="tabMode">scrollable</item>
        <item name="tabGravity">center</item>
        <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="tabSelectedTextColor">?attr/colorOnPrimary</item>
        <item name="tabIndicator">@drawable/tab_pill_indicator</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabIndicatorGravity">stretch</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabMinWidth">104dp</item>
        <item name="tabPaddingStart">20dp</item>
        <item name="tabPaddingEnd">20dp</item>
        <item name="tabTextAppearance">@style/GhostWire.TabText</item>
        <item name="tabRippleColor">@null</item>
        <item name="android:background">@null</item>
    </style>

    <style name="GhostWire.TabText" parent="TextAppearance.AppCompat.Button">
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:fontVariationSettings">'wght' 600</item>
    </style>

</resources>
