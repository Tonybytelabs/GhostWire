<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- GhostWire brand look: a fixed Material 3 dark theme pinned to the Ghost Wire
         palette (mint #3CF2B0 on navy #0B0F14), not Monet, so the app carries its own
         identity regardless of wallpaper. Every view already reads ?attr/colorPrimary /
         colorOnSurfaceVariant / colorOnPrimary, so pinning the roles here recolours all
         of them. The gw_* tokens resolve to values-night (the forced-night default). -->
    <style name="Theme.GhostWire" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/gw_accent</item>
        <item name="colorOnPrimary">@color/gw_on_primary</item>
        <item name="colorPrimaryContainer">@color/gw_primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/gw_on_primary</item>
        <item name="colorSecondary">@color/gw_accent</item>
        <item name="colorOnSecondary">@color/gw_on_primary</item>
        <item name="android:colorBackground">@color/gw_bg</item>
        <item name="colorSurface">@color/gw_surface</item>
        <item name="colorOnSurface">@color/gw_on_surface</item>
        <item name="colorSurfaceVariant">@color/gw_surface</item>
        <item name="colorOnSurfaceVariant">@color/gw_muted</item>
        <item name="colorSurfaceContainerLowest">@color/gw_bg</item>
        <item name="colorSurfaceContainerLow">@color/gw_bg</item>
        <item name="colorSurfaceContainer">@color/gw_surface</item>
        <item name="colorSurfaceContainerHigh">@color/gw_surface</item>
        <item name="colorSurfaceContainerHighest">@color/gw_surface</item>
        <item name="android:statusBarColor">@color/gw_bg</item>
        <item name="android:navigationBarColor">@color/gw_bg</item>
        <item name="materialButtonStyle">@style/GhostWire.Button</item>
        <item name="materialButtonOutlinedStyle">@style/GhostWire.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/GhostWire.Card</item>
        <item name="toolbarStyle">@style/GhostWire.Toolbar</item>
        <!-- Poppins is the Ghost Wire wordmark font; use it for titles. -->
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <!-- Toolbar: the ghost logo sits left of the domain title, set in Poppins. -->
    <style name="GhostWire.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/GhostWire.ToolbarTitle</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
    </style>

    <style name="GhostWire.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Pill buttons, fully-rounded shape, Poppins. -->
    <style name="GhostWire.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <style name="GhostWire.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <!-- Section title at the top of each tab, in the Poppins wordmark font. -->
    <style name="GhostWire.Header" parent="">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Rounded tonal card wrapping a tab's controls/output. Elixir uses 28dp
         corners and a filled surface-container tone, not an elevated white card. -->
    <style name="GhostWire.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Bottom tab pills: accent-filled pill behind the selected label, muted
         unselected text, scrollable. -->
    <style name="GhostWire.TabPill" parent="Widget.Material3.TabLayout">
        <item name="tabMode">scrollable</item>
        <item name="tabGravity">center</item>
        <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="tabSelectedTextColor">?attr/colorOnPrimary</item>
        <item name="tabIndicator">@drawable/tab_pill_indicator</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabIndicatorGravity">stretch</item>
        <!-- Full-width pill on a common minimum width, so short (SIM) and long
             (Recon) labels get the same-sized pill. -->
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabMinWidth">104dp</item>
        <item name="tabPaddingStart">20dp</item>
        <item name="tabPaddingEnd">20dp</item>
        <item name="tabTextAppearance">@style/GhostWire.TabText</item>
        <item name="tabRippleColor">@null</item>
        <item name="android:background">@null</item>
    </style>

    <style name="GhostWire.TabText" parent="TextAppearance.AppCompat.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

</resources>
