<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BT Scan"
        style="@style/GhostWire.Header" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Passive recon with the phone's own radio: nearby BLE advertisers (extended, all PHYs) plus a classic BR/EDR inquiry. Tap a device for full detail. Low-power / opportunistic modes catch slow or stealthy advertisers the low-latency sweep can miss."
        android:paddingBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scan mode"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <Spinner
        android:id="@+id/scan_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/scan_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scan" />

    <TextView
        android:id="@+id/scan_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:fontFamily="monospace" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/scan_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
