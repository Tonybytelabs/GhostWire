<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <!-- App bar: current domain name + the sub-tabs for that domain. -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:logo="@drawable/gw_logo"
            app:titleTextAppearance="@style/GhostWire.ToolbarTitle"
            app:titleTextColor="?attr/colorOnSurface"
            app:titleCentered="false" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            style="@style/GhostWire.TabPill"
            android:layout_width="match_parent"
            android:layout_height="64dp" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content area: the pager scrolls under the floating glass bottom bar
         (padding + clipToPadding=false), so the bar's translucency shows the
         content behind it — the glass look. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="92dp" />

        <!-- Always-visible domain navigation, as a floating glass bar. -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_glass_bar"
            android:elevation="12dp"
            app:elevation="0dp"
            app:itemBackground="@android:color/transparent"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextColor="@color/nav_item_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav" />
    </FrameLayout>
</LinearLayout>
