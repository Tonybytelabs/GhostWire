<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GNSS Spoof"
            style="@style/GhostWire.Header" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device-wide mock location (GPS + network + fused). The GNSS chip can't be made to report a false fix; this overrides location at the framework layer for every app using the standard APIs."
            android:paddingBottom="12dp" />

        <EditText
            android:id="@+id/spoof_lat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Latitude  (e.g. 48.8584)"
            android:inputType="numberSigned|numberDecimal" />

        <EditText
            android:id="@+id/spoof_lon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Longitude (e.g. 2.2945)"
            android:inputType="numberSigned|numberDecimal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/spoof_locate"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Locate on map" />

        <TextView
            android:id="@+id/spoof_map_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="Tap the map to drop the pin, or drag it. The coordinates above stay in sync." />

        <org.osmdroid.views.MapView
            android:id="@+id/spoof_map"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/spoof_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start" />

            <Button
                android:id="@+id/spoof_stop"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stop" />
        </LinearLayout>

        <TextView
            android:id="@+id/spoof_out"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
